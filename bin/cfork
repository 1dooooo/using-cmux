#!/usr/bin/env bash
set -euo pipefail

# cfork - 将会话分叉到新的 cmux 面板

if [[ -z "${CMUX_SOCKET_PATH:-}" ]]; then
  echo "错误: 仅在 cmux 内可使用" >&2
  exit 1
fi

DIR="${1:-right}"
S=$(cmux new-split "$DIR" | awk '{print $2}')
cmux-send --surface "$S" "claude --continue --fork-session\n"
echo "分叉启动: $S (方向: $DIR)"
