#!/usr/bin/env bash
set -euo pipefail

# cmux-grid: 将工作区的面板整理为网格布局
#
# Usage:
#   cmux-grid              将当前工作区自动整理为网格
#   cmux-grid 2x3          整理为指定维度的网格
#   cmux-grid --workspace workspace:7
#
# 工作原理:
#   1. 将所有表面合并到一个面板（标签化）
#   2. 用 new-split down 创建行，用 new-split right 创建列
#   3. 用 move-surface 配置表面，删除骨架的空表面

usage() {
  echo "Usage: cmux-grid [RxC] [--workspace <ref>]"
  echo ""
  echo "  RxC               网格维度（如: 2x2, 2x3）。省略时自动计算"
  echo "  --workspace <ref>  目标工作区（省略时: 当前工作区）"
  exit 0
}

# --- 参数解析 ---
WS="${CMUX_WORKSPACE_ID:-}"
FORCE_ROWS=""
FORCE_COLS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workspace) WS="$2"; shift 2 ;;
    --help|-h) usage ;;
    *x*)
      FORCE_ROWS="${1%%x*}"
      FORCE_COLS="${1##*x}"
      shift ;;
    *) WS="$1"; shift ;;
  esac
done

if [[ -z "${CMUX_SOCKET_PATH:-}" ]]; then
  echo "错误: 不在 cmux 环境中" >&2
  exit 1
fi

if [[ -z "$WS" ]]; then
  echo "错误: 无法确定工作区" >&2
  exit 1
fi

# --- 收集表面 ---
SURFACES=()

while IFS= read -r pane_ref; do
  while IFS= read -r line; do
    surf=$(echo "$line" | grep -o 'surface:[0-9]*')
    [[ -n "$surf" ]] && SURFACES+=("$surf")
  done < <(cmux list-pane-surfaces --workspace "$WS" --pane "$pane_ref" 2>/dev/null)
done < <(cmux list-panes --workspace "$WS" 2>/dev/null | grep -o 'pane:[0-9]*')

N=${#SURFACES[@]}

if [[ $N -le 1 ]]; then
  echo "表面数量为1或更少，无需整理。"
  exit 0
fi

# --- 计算网格维度 ---
if [[ -n "$FORCE_ROWS" && -n "$FORCE_COLS" ]]; then
  ROWS=$FORCE_ROWS
  COLS=$FORCE_COLS
  if [[ $((ROWS * COLS)) -lt $N ]]; then
    echo "错误: ${ROWS}x${COLS} < 表面数${N}" >&2
    exit 1
  fi
else
  # ceil(sqrt(N))
  COLS=1
  while [[ $((COLS * COLS)) -lt $N ]]; do
    COLS=$((COLS + 1))
  done
  ROWS=$(( (N + COLS - 1) / COLS ))
fi

echo "表面 ${N}个 → ${ROWS}×${COLS} 网格"

# --- 辅助函数 ---
get_panes() {
  cmux list-panes --workspace "$WS" 2>/dev/null | grep -o 'pane:[0-9]*'
}

# 用 new-split 创建骨架面板，然后替换表面
# 参数: $1=方向, $2=基准surface, $3=要配置的表面
# 输出: 新面板的ref
scaffold_and_place() {
  local dir="$1" base_surf="$2" target_surf="$3"

  local result
  result=$(cmux new-split "$dir" --workspace "$WS" --surface "$base_surf" 2>/dev/null)
  local scaffold_surf
  scaffold_surf=$(echo "$result" | grep -o 'surface:[0-9]*')

  # 定位包含骨架表面的面板
  local new_pane=""
  while IFS= read -r pane_ref; do
    if cmux list-pane-surfaces --workspace "$WS" --pane "$pane_ref" 2>/dev/null | grep -q "$scaffold_surf"; then
      new_pane="$pane_ref"
      break
    fi
  done < <(get_panes)

  if [[ -z "$new_pane" ]]; then
    echo "警告: 无法检测骨架面板 ($scaffold_surf)" >&2
    return 1
  fi

  cmux move-surface --surface "$target_surf" --pane "$new_pane" --workspace "$WS" 2>/dev/null
  cmux close-surface --surface "$scaffold_surf" --workspace "$WS" 2>/dev/null

  echo "$new_pane"
}

# --- Step 1: 将所有表面合并到首个面板 ---
ANCHOR=$(get_panes | head -1)

for ((i = 1; i < N; i++)); do
  cmux move-surface --surface "${SURFACES[$i]}" --pane "$ANCHOR" --workspace "$WS" 2>/dev/null || true
done
sleep 0.3

echo "合并完成。构建网格中..."

# --- Step 2: 创建行 (new-split down) ---
ROW_PANES=("$ANCHOR")

for ((r = 1; r < ROWS; r++)); do
  start=$((r * COLS))
  [[ $start -ge $N ]] && break

  base_surf="${SURFACES[$(( (r - 1) * COLS ))]}"
  new_pane=$(scaffold_and_place down "$base_surf" "${SURFACES[$start]}")
  ROW_PANES+=("$new_pane")

  # 将该行剩余表面移到同一个面板
  for ((c = 1; c < COLS; c++)); do
    idx=$((start + c))
    [[ $idx -ge $N ]] && break
    cmux move-surface --surface "${SURFACES[$idx]}" --pane "$new_pane" --workspace "$WS" 2>/dev/null || true
  done
done

# --- Step 3: 在每行内创建列 (new-split right) ---
for ((r = 0; r < ${#ROW_PANES[@]}; r++)); do
  start=$((r * COLS))
  row_count=$COLS
  if [[ $((start + row_count)) -gt $N ]]; then
    row_count=$((N - start))
  fi

  for ((c = 1; c < row_count; c++)); do
    idx=$((start + c))
    base_surf="${SURFACES[$((start + c - 1))]}"
    scaffold_and_place right "$base_surf" "${SURFACES[$idx]}" >/dev/null
  done
done

echo "✅ ${ROWS}×${COLS} 网格完成"
